# PRIVATE SEARCH ENGINE - No external APIs required
# This is a fully private search engine with no external integrations
# Search queries remain on this server and are never sent to external services

FLASK_SECRET_KEY=change-this-to-a-random-string-in-production

# =============================================================================
# PROXY CONFIGURATION (Optional - for PythonAnywhere or restricted environments)
# =============================================================================

# Cloudflare Worker Proxy URL (bypass PythonAnywhere whitelist)
# Deploy the worker from cloudflare-worker-proxy.js, then set the URL here
# Example: PROXY_WORKER_URL=https://sodeom-proxy.YOUR-SUBDOMAIN.workers.dev
# PROXY_WORKER_URL=

# =============================================================================
# STRIPE PAYMENT CONFIGURATION (Optional - use Payment Links for easiest setup)
# =============================================================================

# Option 1: Stripe Payment Link (Easiest - No API needed!)
# Create a Payment Link in Stripe Dashboard and paste the URL here
STRIPE_PAYMENT_LINK=https://buy.stripe.com/test_fZu7sM1rF9miexA5FZ18c00

